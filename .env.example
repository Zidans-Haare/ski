# Kopieren nach .env und ausfüllen
PORT=3100
HOST=127.0.0.1
PUBLIC_URL=https://ski.olomek.com
DATA_DIR=./data
# Passwort für die App (ein Benutzer). Leer lassen = ohne Anmeldung
APP_PASSWORD=
# Zufälliger Schlüssel für Sitzungen, mind. 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=
# Strava-API-App: https://www.strava.com/settings/api (Callback-Domain: ski.olomek.com)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
